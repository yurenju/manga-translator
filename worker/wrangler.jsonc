// Hosted Translation 的 Worker（ADR 0006）。最上層是 production；本機用 env.dev 或 env.test：
//   npx wrangler dev -c worker/wrangler.jsonc --env dev   真的 Anthropic（key 放 worker/.dev.vars 的 CLAUDE_API_KEY）
//   npx wrangler dev -c worker/wrangler.jsonc --env test  假的 Anthropic（FakeTranslator），browser test 用
// 兩個本機 env 的寄信都是假的（FAKE_MAIL）：驗證碼印在終端機，也能從 /v1/dev/outbox 取得。
// 兩個本機 env 也開放開發用的端點（DEV_ENDPOINTS）：/v1/dev/free-pages 直接設定免費額度。
// define 與 vars、d1_databases、ratelimits 都不會從最上層繼承，每個 env 各寫一次。
// 寄送驗證碼的頻率限制：同一個 IP 每分鐘 10 次、同一個 email 每分鐘 3 次（畫面上 30 秒後才能重新寄送）。
// Paddle（#94）：MONTHLY_PAGE_LIMIT 是訂閱者每月可翻的頁數。SITE_ORIGIN 是 checkout 頁所在的產品網站（Worker 自己組 checkout 網址）。
//   env.dev 打 Paddle sandbox，PADDLE_API_KEY、PADDLE_PRICE_ID、PADDLE_WEBHOOK_SECRET 放 worker/.dev.vars
//   （從 ~/.config/naruhodo/paddle-sandbox.env 複製）；env.test 的 __FAKE_PADDLE__ 換成假的 Paddle，webhook secret 是測試用的假值。
//   production 的 SITE_ORIGIN、PADDLE_PRICE_ID 與 secrets 在開通時設定（#97）。
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "naruhodo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // 正式的 database_id 在開通 production 時填（#97）；本機 D1 不看這個值
  "d1_databases": [{ "binding": "DB", "database_name": "naruhodo", "database_id": "local", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "SEND_CODE_BY_IP", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SEND_CODE_BY_EMAIL", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
  ],
  "vars": { "MONTHLY_PAGE_LIMIT": "800", "PADDLE_API_BASE_URL": "https://api.paddle.com" },
  "define": { "__FAKE_ANTHROPIC__": "false", "__FAKE_PADDLE__": "false" },
  "env": {
    "dev": {
      "vars": {
        "FAKE_MAIL": "true",
        "DEV_ENDPOINTS": "true",
        "MONTHLY_PAGE_LIMIT": "800",
        "SITE_ORIGIN": "http://localhost:4321",
        "PADDLE_API_BASE_URL": "https://sandbox-api.paddle.com"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "naruhodo", "database_id": "local", "migrations_dir": "migrations" }],
      "ratelimits": [
        { "name": "SEND_CODE_BY_IP", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
        { "name": "SEND_CODE_BY_EMAIL", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
      ],
      "define": { "__FAKE_ANTHROPIC__": "false", "__FAKE_PADDLE__": "false" }
    },
    "test": {
      "vars": {
        "FAKE_MAIL": "true",
        "DEV_ENDPOINTS": "true",
        "MONTHLY_PAGE_LIMIT": "800",
        "SITE_ORIGIN": "http://localhost:4321",
        "PADDLE_WEBHOOK_SECRET": "pdl_ntfset_browser_test"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "naruhodo", "database_id": "local", "migrations_dir": "migrations" }],
      "ratelimits": [
        { "name": "SEND_CODE_BY_IP", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
        { "name": "SEND_CODE_BY_EMAIL", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
      ],
      "define": { "__FAKE_ANTHROPIC__": "true", "__FAKE_PADDLE__": "true" }
    }
  }
}
