# 複製成 site/.env.local（已 gitignore）再填值；值從 ~/.config/naruhodo/paddle-sandbox.env 來（scripts/paddle-sandbox-wizard.sh）
# Paddle 的 client-side token（sandbox 是 test_ 開頭）：會打包進網頁，本來就是公開的
PUBLIC_PADDLE_CLIENT_TOKEN=
# sandbox 或 production；是 sandbox 時 checkout 頁才呼叫 Paddle.Environment.set('sandbox')
PUBLIC_PADDLE_ENVIRONMENT=sandbox
