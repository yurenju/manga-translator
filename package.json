{
  "name": "manga-translator",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that translates Japanese manga pages in place",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "build:e2e": "node scripts/build.ts --e2e",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build:e2e && playwright test"
  },
  "dependencies": {
    "kuromoji": "0.1.2",
    "onnxruntime-web": "1.30.0",
    "preact": "^11.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.6",
    "@types/kuromoji": "0.1.3",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
